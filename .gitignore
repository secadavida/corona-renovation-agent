# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   managed by the developer. For a binary or executable, it might be more appropriate to
#   check it in.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in cases where the lockfile contains platform-specific dependencies, it may be
#   better to ignore it.
#Pipfile.lock

# poetry
#   Using Poetry requires poetry.lock to be in version control, but you may want to ignore it
#   if you are developing a library where the end-user installs constraints.
#poetry.lock

# pdm
#   PDM stores local configuration in .pdm.toml
.pdm.toml
.pdm-plugins/
__pdm-build__/

