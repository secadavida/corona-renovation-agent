{
	"name": "corona-renovation-agent",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
		"dev:backend": "python -m uvicorn backend.api.main:app --reload --host 0.0.0.0 --port 8000",
		"dev:frontend": "cd frontend && npm start",
		"install:all": "npm install && cd frontend && npm install && cd .. && pip install -r requirements.txt"
	},
	"repository": {
		"type": "git",
		"url": "git@secadavida:secadavida/corona-renovation-agent.git"
	},
	"devDependencies": {
		"concurrently": "^10.0.4"
	}
}
